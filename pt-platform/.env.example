# === Supabase ===
# Found in Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Admin ===
# The email address YOU log in with. Everyone else is treated as a client.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
ADMIN_EMAIL=you@example.com

# === Square ===
# Found in Square Developer Dashboard > your app > Credentials
# Use sandbox keys first to test, then switch to production keys when ready
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
SQUARE_PLAN_VARIATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://yourdomain.com/api/square/webhook
